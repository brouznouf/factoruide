{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Factoruide",
  "identifier": "fr.brouz.factoruide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Factoruide",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFQTA3RkMzMUJFQzNCQjQKUldTME8rd2J3MytnVHF4VVpnMk16OXU1ek1DQWxmeXdDS0FHdC92Q2R4WW1qd0lRZUFpcUlJSUoK",
      "endpoints": [
        "https://github.com/brouznouf/factoruide/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
